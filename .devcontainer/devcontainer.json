{
  "name": "Chat App (Python 3.14)",
  "image": "mcr.microsoft.com/devcontainers/python:3-3.14-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "TASKS.md",
        "streamlit_app.py"
      ]
    },
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/workspaces/${localWorkspaceFolderBasename}/.venv/bin/python"
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.debugpy",
        "charliermarsh.ruff",
        "ms-vsliveshare.vsliveshare"
      ]
    }
  },
  // Runs once when the codespace is created (and during prebuilds).
  "updateContentCommand": "if [ -f packages.txt ]; then sudo apt update && sudo xargs apt install -y < packages.txt; fi; bash scripts/setup.sh",
  // Starts the app every time someone opens the codespace.
  "postAttachCommand": {
    "server": "bash scripts/run.sh --server.headless true --server.enableCORS false --server.enableXsrfProtection false"
  },
  "portsAttributes": {
    "8501": {
      "label": "GPA Calculator",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [
    8501
  ]
}
